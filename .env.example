# Assist Roofing — Environment Variables Configuration Template
# For cPanel: Configure these variables in cPanel > Setup Node.js App > Environment Variables
# For Local: Copy this file to .env and customize values

# Application Port (cPanel Passenger sets this dynamically. Fallback is 3000)
PORT=3000

# Environment Mode (production / development)
NODE_ENV=production

# Initial Administrator Account (Used only on initial startup if database has no admin)
INITIAL_ADMIN_EMAIL=admin@assistroofing.com.au
INITIAL_ADMIN_PASSWORD=

# Optional Base API URL (defaults to /api if omitted or relative)
VITE_API_URL=/api

# Google Analytics 4 & Google Ads Configuration
VITE_GA4_ID=G-VTEV53E3T3
VITE_GOOGLE_ADS_ID=AW-18404411620
VITE_GOOGLE_ADS_CALL_CONVERSION=
VITE_GOOGLE_ADS_LEAD_CONVERSION=
VITE_PHONE_CONVERSION_NUMBER="0478 250 790"
