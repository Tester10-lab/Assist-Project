rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) || 
        ('email' in request.auth.token && request.auth.token.email == 'admin@assistroofing.com.au' && request.auth.token.email_verified == true)
      );
    }

    match /pages/{document} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /services/{document} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /locations/{document} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /blog/{document} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /media/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SEO and Settings are stored as global/seo and global/settings
    match /global/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /enquiries/{document} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'address', 'service', 'preferredTime', 'urgency', 'message', 'type', 'status', 'createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 2000
                    && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 40))
                    && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() < 250))
                    && (!('service' in request.resource.data) || (request.resource.data.service is string && request.resource.data.service.size() < 100))
                    && (!('preferredTime' in request.resource.data) || (request.resource.data.preferredTime is string && request.resource.data.preferredTime.size() < 100))
                    && (!('urgency' in request.resource.data) || (request.resource.data.urgency is string && request.resource.data.urgency.size() < 50))
                    && (!('type' in request.resource.data) || (request.resource.data.type is string && request.resource.data.type.size() < 50))
                    && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() < 50));
      allow read, update, delete: if isAdmin();
    }
    match /activity/{document} {
      allow read, write: if isAdmin();
    }

    // Deny all other paths by default (no wildcard catch-all)
  }
}
